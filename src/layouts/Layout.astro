---
import '../styles/global.css';
import {themes} from '../data/themes.mjs';
const css=themes.map(t=>`html[data-theme="${t.id}"]{color-scheme:${t.kind};--bg:${t.bg};--panel:${t.panel};--ink:${t.ink};--muted:${t.muted};--line:${t.line};--accent:${t.accent};--secondary:${t.secondary};--selection:${t.selection}}`).join('\n');
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en" data-theme="solarized-light"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Vishal KVS — Curiosity, code & a little possibility.</title><meta name="description" content="Vishal KVS — Computer Science student exploring AI, machine learning, and thoughtful software. Come for the projects. Stay for the ASCII."/><meta name="theme-color" content="#fdf6e3"/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><meta property="og:title" content="Vishal KVS — A curious mind, building thoughtful things."/><meta property="og:description" content="AI, machine learning, creative code, and a little ASCII playground."/><meta property="og:type" content="website"/><meta property="og:url" content="https://therealvik3939-cloud.github.io/Portfolio/"/><style is:global set:html={css}/><script is:inline>try{const valid=['solarized-light','solarized-dark','dark-modern','light-modern','monokai','quiet-light','abyss','high-contrast'];const saved=localStorage.getItem('vishal-editor-theme');if(valid.includes(saved))document.documentElement.dataset.theme=saved;if(localStorage.getItem('vishal-motion')==='off')document.documentElement.dataset.motion='off'}catch(e){}</script></head><body><a class="skip-link" href="#main">Skip to content</a><div class="scroll-progress" aria-hidden="true"></div><slot/><script>import '../scripts/main.ts';</script></body></html>
